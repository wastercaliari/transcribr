# ==============================================================================
# TranscriBR - Arquivo de Configuração de Ambiente (.env)
# ==============================================================================
# Para iniciar o bot, você só precisa preencher os 2 campos OBRIGATÓRIOS abaixo:
# 1. DISCORD_BOT_TOKEN
# 2. GROQ_API_KEY
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES OBRIGATÓRIAS
# ------------------------------------------------------------------------------

# Token do Bot gerado no Discord Developer Portal (https://discord.com/developers/applications)
# Vá em sua aplicação -> Bot -> Reset Token
DISCORD_BOT_TOKEN=cole_seu_token_aqui

# Chave de API da Groq Cloud (100% gratuita, sem necessidade de cartão de crédito)
# Obtenha em: https://console.groq.com/keys
# Utilizada para transcrição ultrarrápida Whisper Large-v3 (~500ms) e atas com LLM
GROQ_API_KEY=gsk_cole_sua_chave_groq_aqui

# Ordem de prioridade dos motores de voz (padrão: groq)
STT_ORDER=groq

# ------------------------------------------------------------------------------
# 2. SERVIDOR WEB, DASHBOARD & OBSERVABILIDADE (Opcional)
# ------------------------------------------------------------------------------

# Porta do servidor HTTP interno para /dashboard, /health e /metrics (Prometheus)
# Padrão: 8080 (ou a porta atribuída dinamicamente pelo Railway/Render via $PORT)
PORT=8080

# Credenciais de autenticação básica para /dashboard, /api/recent-speeches e /api/telemetry
# Se DASHBOARD_PASSWORD estiver vazio ou ausente, os endpoints ficam abertos (compatibilidade)
# /health e /metrics permanecem sempre abertos para probes de liveness e Prometheus scraper
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Webhook opcional do canal onde as transcrições serão enviadas
# (Se não preenchido, o bot busca ou cria automaticamente o canal "transcribr-")
TRANSCRIBR_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 3. GRAVAÇÃO DE ÁUDIO WAV & MEMÓRIA (Opcional)
# ------------------------------------------------------------------------------

# Habilitar buffer em memória para exportação de áudio WAV via /audio e anexo no /resumo
ENABLE_AUDIO_RECORDING=true

# Limite máximo de memória de áudio por servidor em Megabytes (Padrão: 25)
# Consumo desprezível de RAM (~R$ 0,02/mês no Railway), com expurgo FIFO automático.
MAX_AUDIO_BUFFER_MB=25

# ------------------------------------------------------------------------------
# 4. BANCO DE DADOS EMBARCADO SQLITE (Opcional)
# ------------------------------------------------------------------------------

# Caminho do banco persistente com modo WAL (sobrevive a reinícios e redeploys)
# No Railway com Persistent Volume montado em /app/data, use: /app/data/transcribr.sqlite
SQLITE_DB_PATH=./data/transcribr.sqlite

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÕES ENTERPRISE (Opcional)
# ------------------------------------------------------------------------------

# Sincronização automática de atas técnicas no Atlassian Confluence
ATLASSIAN_DOMAIN=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
CONFLUENCE_SPACE_KEY=TBR

# Integração com Jira Cloud para criação de tarefas faladas via /jira
JIRA_PROJECT_KEY=SCRUM

# Despacho automático de atas para canais corporativos (Slack e Teams)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Canal de alertas para palavras-chave críticas de engenharia (Incidentes/Segurança)
CRITICAL_ALERTS_WEBHOOK_URL=
