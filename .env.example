# ==========================================
# Configurações do TranscriBR (100% Groq Cloud / Local)
# ==========================================

# Token do Bot no Portal do Discord Developer (Obrigatório)
DISCORD_BOT_TOKEN=cole_o_token_do_bot_aqui

# Chave da Groq para Whisper Large-v3 e Resumos com Llama 3.3 / GPT-OSS 120B (100% Gratuito)
# Obtenha grátis em: https://console.groq.com/keys
GROQ_API_KEY=

# Webhook opcional do canal onde as transcrições serão enviadas
TRANSCRIBR_WEBHOOK_URL=

# Motor de transcrição (Padrão: groq)
STT_ORDER=groq

# ==========================================
# Otimização de Custos e Memória (Railway)
# ==========================================
# Ativação do buffer de áudio WAV para /audio e /resumo (Padrão: true)
ENABLE_AUDIO_RECORDING=true

# Limite máximo de memória do buffer por servidor em Megabytes (Padrão: 25)
# Um teto de 25 MB consome apenas R$ 0,02/mês de RAM no Railway e não cresce com chamadas longas.
MAX_AUDIO_BUFFER_MB=25

# ==========================================
# Banco de Dados Embarcado SQLite (SCRUM-54)
# ==========================================
# Caminho do banco persistente com WAL mode (sobrevive a reinícios e redeploys)
# No Railway com Persistent Volume, aponte para um diretório no volume (ex.: /app/data/transcribr.sqlite)
SQLITE_DB_PATH=./data/transcribr.sqlite
