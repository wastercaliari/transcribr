# ==========================================
# Configurações do TranscriBR (Railway / Nuvem / Local)
# ==========================================

# Token do Bot no Portal do Discord Developer (Obrigatório)
DISCORD_BOT_TOKEN=cole_o_token_do_bot_aqui

# Chave da Groq para Whisper Large-v3 gratuito e ultra-rápido (Altamente recomendado)
# Obtenha grátis em: https://console.groq.com/keys
GROQ_API_KEY=

# Chave da OpenAI para GPT-5.6 Luna (Principal para /resumo)
OPENAI_API_KEY=

# Chave do Google Gemini para comandos de /resumo e fallback (Recomendado)
# Obtenha grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Webhook opcional do canal onde as transcrições serão enviadas
TRANSCRIBR_WEBHOOK_URL=

# Ordem de motores de transcrição (No Railway, use 'groq,gemini')
STT_ORDER=groq,gemini

# Segunda opinião em caso de áudio incerto (1 = ligada, 0 = desligada)
SECOND_OPINION=1
